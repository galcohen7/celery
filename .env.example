# העתק קובץ זה ל-.env ומלא את הערכים.
# בפריסה ל-Render אין צורך בקובץ הזה — render.yaml מזריק את המשתנים אוטומטית.

# מסד הנתונים — PostgreSQL (זה מה שמוגדר ב-prisma/schema.prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/celery"

# להרצה מקומית ללא Postgres מותקן: החלף ב-schema.prisma את provider ל-"sqlite"
# והשתמש בשורה הבאה במקום זו שלמעלה:
# DATABASE_URL="file:./dev.db"

# מפתח לחתימת טוקנים — חובה להחליף למחרוזת אקראית ארוכה
JWT_SECRET="change-me-to-a-long-random-string"

# מפתח Claude API — נדרש לניתוח תלושים ודוחות עו״ש.
# להשגה: console.anthropic.com. בלעדיו נקודות ה-/api/documents מחזירות 503
# עם הסבר, ושאר האפליקציה עובדת כרגיל.
ANTHROPIC_API_KEY=""

# מייל איפוס סיסמה דרך Brevo (brevo.com, חינמי עד 300 מיילים ביום).
# בלעדיהם, בפיתוח הקוד מוחזר בתגובה; בייצור — איפוס לא יגיע למשתמש.
BREVO_API_KEY=""
MAIL_FROM=""            # כתובת שולח שאומתה ב-Brevo
APP_URL="http://localhost:4000"

# פורט השרת
PORT=4000

# סביבה: development / production
NODE_ENV="development"
