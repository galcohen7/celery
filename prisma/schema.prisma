// מסד הנתונים — PostgreSQL בענן. לפיתוח מקומי אפשר להחליף provider ל-"sqlite"
// ו-DATABASE_URL ל-"file:./dev.db".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// firstName/lastName אופציונליים בסכימה בכוונה: חשבונות שנוצרו לפני שלב B1
// אינם מכילים אותם, ועמודה חובה הייתה מפילה את המיגרציה על שורות קיימות.
// בהרשמה חדשה שניהם נדרשים — האכיפה בשכבת ה-controller.
model User {
  id           Int                  @id @default(autoincrement())
  email        String               @unique
  firstName    String?
  lastName     String?
  passwordHash String
  createdAt    DateTime             @default(now())
  workdays     WorkDay[]
  expenses     Expense[]
  wageProfile  WageProfile?
  taxProfile   TaxProfile?
  payslips     PayslipAnalysis[]
  statement    StatementLine[]
  resetTokens  PasswordResetToken[]
}

model WorkDay {
  id     Int    @id @default(autoincrement())
  userId Int
  date   String // 'YYYY-MM-DD'
  dow    Int    // 0=ראשון ... 6=שבת
  start  String // 'HH:MM'
  end    String // 'HH:MM'
  salary Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// סכומים נשמרים ב**אגורות** כמספר שלם, לא בשקלים עשרוניים.
// הוצאות מגיעות עם אגורות (42.90) ובשלב D יושוו לשורות עו״ש; חישוב עשרוני
// ב-JS היה מכניס שגיאות צבירה (0.1+0.2). המרה לשקלים נעשית בקצה התצוגה בלבד.
// הערה: `category` ו-`source` הם String ולא enum — Prisma לא תומך ב-enum ב-SQLite,
// וזה היה שובר את ההרצה המקומית.
model Expense {
  id          Int      @id @default(autoincrement())
  userId      Int
  date        String   // 'YYYY-MM-DD'
  amountAgorot Int
  description String   // טקסט חופשי — השדה המרכזי בהזנה
  category    String   // נגזר אוטומטית מהתיאור, ניתן לעריכה
  merchant    String?
  source      String   @default("MANUAL") // MANUAL | STATEMENT
  matchedStatementLineId Int?              // מתמלא בהצלבת עו״ש
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// פרופיל השכר האישי. מחליף את הקבועים שהיו בקוד (spec.md 5.1).
//
// כל תעריף מיוצג כזוג mode+value: PERCENT = אחוז מתעריף הבסיס (150 → פי 1.5),
// ABSOLUTE = סכום בשקלים לשעה. כך המשתמש יכול לכתוב "150%" או "60 ₪" — מה
// שנוח לו — ושינוי תעריף הבסיס מתגלגל אוטומטית במצב PERCENT.
//
// ⚠️ ברירות המחדל מייצרות בדיוק את ההתנהגות הקודמת: 40 ₪ בסיס, סופ״ש 150%
// (=60), נוספות 125%, סף 8 שעות, שישי משולם עד 23:00. משתמש קיים לא רואה
// שום שינוי בימים שכבר הוזנו — ואלה לא מחושבים מחדש לעולם (spec.md 5.2).
model WageProfile {
  id            Int    @id @default(autoincrement())
  userId        Int    @unique
  payType       String @default("HOURLY") // HOURLY | MONTHLY
  hourlyRate    Float  @default(40)
  monthlySalary Float?

  overtimeMode  String @default("PERCENT")  // PERCENT | ABSOLUTE
  overtimeValue Float  @default(125)
  weekendMode   String @default("PERCENT")
  weekendValue  Float  @default(150)
  holidayMode   String @default("PERCENT")
  holidayValue  Float  @default(150)

  overtimeThresholdHours Float   @default(8)
  weekendStartDow        Int     @default(5)  // שישי
  weekendStartHour       Int     @default(16)
  weekendEndDow          Int     @default(0)  // ראשון
  weekendEndHour         Int     @default(8)
  fridayPaidUntil        String? @default("23:00") // null = ללא הארכה

  // זכאות חופשה ומחלה. ברירת המחדל למחלה היא המינימום החוקי (1.5 ליום חודש,
  // תקרה 90). לחופשה אין ברירת מחדל: היא תלויה בוותק ובהסכם, ולכן נלקחת
  // מהתלוש או מוגדרת ידנית ולא מנוחשת.
  annualVacationDays   Float?
  sickAccrualPerMonth  Float @default(1.5)
  sickAccrualCap       Float @default(90)

  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// פרופיל המס האישי שמזין את מנוע המס.
// exemptions נשמר כמחרוזת JSON — אין טיפוס Json ב-SQLite.
model TaxProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  creditPoints   Float    @default(2.25)
  pensionPercent Float    @default(0)
  entitlements   String   @default("[]") // JSON: מזהי זכאויות שנבחרו מהרישום
  manualOverride Boolean  @default(false) // המשתמש הזין מספר נקודות בעצמו
  exemptions     String   @default("[]") // JSON: [{section, description, amount|percent}]
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// תוצאת ניתוח תלוש. **המסמך המקורי אינו נשמר** — רק המספרים שהמשתמש אישר.
// שדות מורכבים נשמרים כמחרוזת JSON ולא כ-Json: Prisma לא תומך בטיפוס Json
// ב-SQLite, וזה היה שובר את ההרצה המקומית (אותה מגבלה כמו enum ב-Expense).
model PayslipAnalysis {
  id            Int      @id @default(autoincrement())
  userId        Int
  month         String   // 'YYYY-MM'
  grossAgorot   Int?
  netAgorot     Int?
  deductions    String   @default("{}") // JSON: incomeTax, nationalInsurance, healthTax, pension, other
  hoursReported Float?
  daysReported  Int?
  vacationBalance Float?  // יתרת ימי חופשה כפי שמופיעה בתלוש
  sickBalance     Float?  // יתרת ימי מחלה כפי שמופיעה בתלוש
  comparison    String   @default("{}") // JSON: הצלבה מול היומן
  alerts        String   @default("[]") // JSON: מערך התראות
  reportText    String   @default("")
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

// שורה מדוח עו״ש. גם כאן — הדוח המקורי אינו נשמר, רק השורות שחולצו ואושרו.
model StatementLine {
  id               Int      @id @default(autoincrement())
  userId           Int
  date             String   // 'YYYY-MM-DD'
  amountAgorot     Int
  merchantRaw      String
  matchStatus      String   @default("REVIEW") // MATCHED | REVIEW | ANOMALY
  matchedExpenseId Int?
  confidence       Float?
  alertReason      String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
