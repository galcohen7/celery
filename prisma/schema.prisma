// מסד הנתונים — PostgreSQL בענן. לפיתוח מקומי אפשר להחליף provider ל-"sqlite"
// ו-DATABASE_URL ל-"file:./dev.db".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// firstName/lastName אופציונליים בסכימה בכוונה: חשבונות שנוצרו לפני שלב B1
// אינם מכילים אותם, ועמודה חובה הייתה מפילה את המיגרציה על שורות קיימות.
// בהרשמה חדשה שניהם נדרשים — האכיפה בשכבת ה-controller.
model User {
  id           Int                  @id @default(autoincrement())
  email        String               @unique
  firstName    String?
  lastName     String?
  passwordHash String
  createdAt    DateTime             @default(now())
  workdays     WorkDay[]
  expenses     Expense[]
  resetTokens  PasswordResetToken[]
}

model WorkDay {
  id     Int    @id @default(autoincrement())
  userId Int
  date   String // 'YYYY-MM-DD'
  dow    Int    // 0=ראשון ... 6=שבת
  start  String // 'HH:MM'
  end    String // 'HH:MM'
  salary Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// סכומים נשמרים ב**אגורות** כמספר שלם, לא בשקלים עשרוניים.
// הוצאות מגיעות עם אגורות (42.90) ובשלב D יושוו לשורות עו״ש; חישוב עשרוני
// ב-JS היה מכניס שגיאות צבירה (0.1+0.2). המרה לשקלים נעשית בקצה התצוגה בלבד.
// הערה: `category` ו-`source` הם String ולא enum — Prisma לא תומך ב-enum ב-SQLite,
// וזה היה שובר את ההרצה המקומית.
model Expense {
  id          Int      @id @default(autoincrement())
  userId      Int
  date        String   // 'YYYY-MM-DD'
  amountAgorot Int
  description String   // טקסט חופשי — השדה המרכזי בהזנה
  category    String   // נגזר אוטומטית מהתיאור, ניתן לעריכה
  merchant    String?
  source      String   @default("MANUAL") // MANUAL | STATEMENT
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
